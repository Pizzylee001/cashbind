{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 25
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|deck\\.html|deck-assets/|CashBind-Demo-Video\\.mp4|favicon\\.svg|cashbind-logo\\.png|apple-touch-icon\\.png).*)",
      "destination": "/index.html"
    }
  ]
}
